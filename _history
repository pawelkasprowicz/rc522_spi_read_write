 type=\"device_print_message\" disabled-reasons=\"pxt_automatic_disabled\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">Witaj!</field></shadow><block type=\"MFRC522_read\" disabled-reasons=\"pxt_automatic_disabled\"></block></value><next><block type=\"device_pause\" disabled-reasons=\"pxt_automatic_disabled\"><value name=\"pause\"><shadow type=\"timePicker\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"ms\">1000</field></shadow></value></block></next></block></next></block></next></block><block type=\"device_show_number\" disabled-reasons=\"pxt_automatic_disabled\" x=\"518\" y=\"549\"><value name=\"number\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">0</field></shadow></value></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":5297,"diffs":[[1,"MFRC522.Init()\nlet licznik = 0\nbasic.showIcon(IconNames.Heart)\nbasic.forever(function () {\n    licznik += 1\n    MFRC522.write(\"pawel\")\n    basic.pause(1000)\n    basic.showString(\"\" + (MFRC522.getID()))\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":147,"length1":156,"diffs":[[1,"        \"pxt-mfrc522\": \"github:joy-it/pxt-rfid-mfrc522#1.0.1\"\n"]]},{"start1":273,"length1":39,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":300,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"added","filename":"main.py","value":"# ==========================================\n# RFID RC522 + KITRONIK OLED 128x64\n# micro:bit V2 - MakeCode Python\n# ==========================================\n\n# Zmienne\nlast_uid = \"\"\ncard_count = 0\ncard_present = False\n\n\n# ==========================================\n# OBSLUGA REJESTROW RC522\n# ==========================================\n\ndef write_reg(reg, value):\n    pins.digital_write_pin(DigitalPin.P16, 0)\n    pins.spi_write((reg << 1) & 0x7E)\n    pins.spi_write(value & 255)\n    pins.digital_write_pin(DigitalPin.P16, 1)\n\n\ndef read_reg(reg):\n    pins.digital_write_pin(DigitalPin.P16, 0)\n    pins.spi_write(((reg << 1) & 0x7E) | 0x80)\n    value = pins.spi_write(0)\n    pins.digital_write_pin(DigitalPin.P16, 1)\n    return value\n\n\ndef set_bits(reg, mask):\n    write_reg(reg, read_reg(reg) | mask)\n\n\ndef clear_bits(reg, mask):\n    write_reg(reg, read_reg(reg) & (255 ^ mask))\n\n\n# ==========================================\n# INICJALIZACJA RC522\n# ==========================================\n\ndef rc522_init():\n    pins.digital_write_pin(DigitalPin.P16, 1)\n    basic.pause(100)\n\n    # Reset programowy\n    write_reg(0x01, 0x0F)\n    basic.pause(100)\n\n    # Konfiguracja timera\n    write_reg(0x2A, 0x80)\n    write_reg(0x2B, 0xA9)\n    write_reg(0x2C, 0x03)\n    write_reg(0x2D, 0xE8)\n\n    # Konfiguracja transmisji\n    write_reg(0x15, 0x40)\n    write_reg(0x11, 0x3D)\n\n    # Wlaczenie anteny\n    set_bits(0x14, 0x03)\n\n\n# ==========================================\n# KOMUNIKACJA Z KARTA\n# ==========================================\n\ndef communicate(data, last_bits):\n    write_reg(0x01, 0)\n    write_reg(0x04, 0x7F)\n    write_reg(0x0A, 0x80)\n\n    for b in data:\n        write_reg(0x09, b)\n\n    write_reg(0x0D, last_bits)\n    write_reg(0x01, 0x0C)\n    set_bits(0x0D, 0x80)\n\n    completed = False\n\n    for i in range(200):\n        irq = read_reg(0x04)\n\n        if (irq & 0x30) != 0:\n            completed = True\n            break\n\n        if (irq & 0x01) != 0:\n            break\n\n        control.wait_micros(100)\n\n    clear_bits(0x0D, 0x80)\n\n    if not completed:\n        return []\n\n    if (read_reg(0x06) & 0x13) != 0:\n        return []\n\n    count = read_reg(0x0A)\n    result = []\n\n    for i in range(count):\n        result.append(read_reg(0x09))\n\n    return result\n\n\n# ==========================================\n# KONWERSJA NA HEX\n# ==========================================\n\ndef byte_to_hex(value):\n    digits = \"0123456789ABCDEF\"\n    high = (value >> 4) & 15\n    low = value & 15\n    return digits.char_at(high) + digits.char_at(low)\n\n\n# ==========================================\n# ODCZYT UID\n# ==========================================\n\ndef read_uid():\n    response = communicate([0x26], 7)\n\n    if len(response) != 2:\n        return \"\"\n\n    response = communicate([0x93, 0x20], 0)\n\n    if len(response) != 5:\n        return \"\"\n\n    bcc = response[0] ^ response[1] ^ response[2] ^ response[3]\n\n    if bcc != response[4]:\n        return \"\"\n\n    uid = \"\"\n\n    for i in range(4):\n        uid = uid + byte_to_hex(response[i])\n\n    return uid\n\n\n# ==========================================\n# WYSWIETLACZ OLED\n# ==========================================\n\ndef show_oled(uid, count):\n    kitronik_VIEW128x64.clear()\n\n    kitronik_VIEW128x64.show(\"RFID RC522\")\n    kitronik_VIEW128x64.show(\"UID:\")\n    kitronik_VIEW128x64.show(uid)\n    kitronik_VIEW128x64.show(\"Licznik:\")\n    kitronik_VIEW128x64.show(\"\" + str(count))\n\n    kitronik_VIEW128x64.refresh()\n\n\n# ==========================================\n# KONFIGURACJA SPI\n# ==========================================\n\npins.spi_pins(\n    DigitalPin.P14,\n    DigitalPin.P15,\n    DigitalPin.P13\n)\n\npins.spi_format(8, 0)\npins.spi_frequency(1000000)\n\npins.digital_write_pin(DigitalPin.P16, 1)\n\n\n# ==========================================\n# START PROGRAMU\n# ==========================================\n\nbasic.show_icon(IconNames.DIAMOND)\n\nrc522_init()\n\nversion = read_reg(0x37)\n\nserial.write_string(\"RC522 VERSION: \")\nserial.write_number(version)\nserial.write_line(\"\")\n\nkitronik_VIEW128x64.clear()\nkitronik_VIEW128x64.show(\"RFID RC522\")\nkitronik_VIEW128x64.show(\"Przyloz karte\")\nkitronik_VIEW128x64.refresh()\n\nbasic.pause(1000)\nbasic.clear_screen()\n\n\n# ==========================================\n# PETLA GLOWNA\n# ==========================================\n\ndef on_forever():\n    global last_uid, card_count, card_present\n\n    uid = read_uid()\n\n    if uid != \"\":\n        if not card_present or uid != last_uid:\n            card_count += 1\n            last_uid = uid\n\n            serial.write_line(\"UID: \" + uid)\n            serial.write_number(card_count)\n            serial.write_line(\"\")\n\n            show_oled(uid, card_count)\n\n            basic.show_icon(IconNames.YES)\n            basic.pause(300)\n            basic.clear_screen()\n\n        card_present = True\n    else:\n        card_present = False\n\n    basic.pause(200)\n\n\nbasic.forever(on_forever)"}]},{"timestamp":1794065136622,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"//  ==========================================\n//  RFID RC522 + KITRONIK OLED 128x64\n//  micro:bit V2 - MakeCode Python\n//  ==========================================\n//  Zmienne\nlet last_uid = \"\"\nlet card_count = 0\nlet card_present = false\n//  ==========================================\n//  OBSLUGA REJESTROW RC522\n//  ==========================================\nfunction write_reg(reg: number, value: number) {\n    pins.digitalWritePin(DigitalPin.P16, 0)\n    pins.spiWrite(reg << 1 & 0x7E)\n    pins.spiWrite(value & 255)\n    pins.digitalWritePin(DigitalPin.P16, 1)\n}\n"]]},{"start1":569,"length1":0,"diffs":[[1,"function read_reg(reg: number): number {\n    pins.digitalWritePin(DigitalPin.P16, 0)\n    pins.spiWrite(reg << 1 & 0x7E | 0x80)\n    let value = pins.spiWrite(0)\n    pins.digitalWritePin(DigitalPin.P16, 1)\n    return value\n}\n\nfunction set_bits(reg: number, mask: number) {\n    write_reg(reg, read_reg(reg) | mask)\n}\n\nfunction clear_bits(reg: number, mask: number) {\n    write_reg(reg, read_reg(reg) & (255 ^ mask))\n}\n\n//  ==========================================\n//  INICJALIZACJA RC522\n//  ==========================================\nfunction rc522_init() {\n    pins.digitalWritePin(DigitalPin.P16, 1)\n    basic.pause(100)\n    //  Reset programowy\n    write_reg(0x01, 0x0F)\n    basic.pause(100)\n    //  Konfiguracja timera\n    write_reg(0x2A, 0x80)\n    write_reg(0x2B, 0xA9)\n    write_reg(0x2C, 0x03)\n    write_reg(0x2D, 0xE8)\n    //  Konfiguracja transmisji\n    write_reg(0x15, 0x40)\n    write_reg(0x11, 0x3D)\n    //  Wlaczenie anteny\n    set_bits(0x14, 0x03)\n}\n\n//  ==========================================\n//  KOMUNIKACJA Z KARTA\n//  ==========================================\nfunction communicate(data: number[], last_bits: number): number[] {\n    let i: number;\n    let irq: number;\n    write_reg(0x01, 0)\n    write_reg(0x04, 0x7F)\n    write_reg(0x0A, 0x80)\n    for (let b of data) {\n        write_reg(0x09, b)\n    }\n    write_reg(0x0D, last_bits)\n    write_reg(0x01, 0x0C)\n    set_bits(0x0D, 0x80)\n    let completed = false\n    for (i = 0; i < 200; i++) {\n        irq = read_reg(0x04)\n        if ((irq & 0x30) != 0) {\n            completed = true\n            break\n        }\n        \n        if ((irq & 0x01) != 0) {\n            break\n        }\n        \n        control.waitMicros(100)\n    }\n    clear_bits(0x0D, 0x80)\n    if (!completed) {\n        return []\n    }\n    \n    if ((read_reg(0x06) & 0x13) != 0) {\n        return []\n    }\n    \n    let count = read_reg(0x0A)\n    let result = []\n    for (i = 0; i < count; i++) {\n        result.push(read_reg(0x09))\n    }\n    return result\n}\n\n//  ==========================================\n//  KONWERSJA NA HEX\n//  ==========================================\nfunction byte_to_hex(value: number) {\n    let digits = \"0123456789ABCDEF\"\n    let high = value >> 4 & 15\n    let low = value & 15\n    return digits.charAt(high) + digits.charAt(low)\n}\n\n//  ==========================================\n//  ODCZYT UID\n//  ==========================================\nfunction read_uid(): string {\n    let response = communicate([0x26], 7)\n    if (response.length != 2) {\n        return \"\"\n    }\n    \n    response = communicate([0x93, 0x20], 0)\n    if (response.length != 5) {\n        return \"\"\n    }\n    \n    let bcc = response[0] ^ response[1] ^ response[2] ^ response[3]\n    if (bcc != response[4]) {\n        return \"\"\n    }\n    \n    let uid = \"\"\n    for (let i = 0; i < 4; i++) {\n        uid = uid + byte_to_hex(response[i])\n    }\n    return uid\n}\n\n//  ==========================================\n//  WYSWIETLACZ OLED\n//  ==========================================\nfunction show_oled(uid: string, count: number) {\n    kitronik_VIEW128x64.clear()\n    kitronik_VIEW128x64.show(\"RFID RC522\")\n    kitronik_VIEW128x64.show(\"UID:\")\n    kitronik_VIEW128x64.show(uid)\n    kitronik_VIEW128x64.show(\"Licznik:\")\n    kitronik_VIEW128x64.show(\"\" + (\"\" + count))\n    kitronik_VIEW128x64.refresh()\n}\n\n//  ==========================================\n//  KONFIGURACJA SPI\n//  ==========================================\npins.spiPins(DigitalPin.P14, DigitalPin.P15, DigitalPin.P13)\npins.spiFormat(8, 0)\npins.spiFrequency(1000000)\npins.digitalWritePin(DigitalPin.P16, 1)\n//  ==========================================\n//  START PROGRAMU\n//  ==========================================\nbasic.showIcon(IconNames.Diamond)\nrc522_init()\nlet version = read_reg(0x37)\nserial.writeString(\"RC522 VERSION: \")\nserial.writeNumber(version)\nserial.writeLine(\"\")\nkitronik_VIEW128x64.clear()\nkitronik_VIEW128x64.show(\"RFID RC522\")\nkitronik_VIEW128x64.show(\"Przyloz karte\")\nkitronik_VIEW128x64.refresh()\nbasic.pause(1000)\nbasic.clearScreen()\n//  ==========================================\n//  PETLA GLOWNA\n//  ==========================================\nbasic.forever(function on_forever() {\n    \n    let uid = read_uid()\n    if (uid != \"\") {\n        if (!card_present || uid != last_uid) {\n            card_count += 1\n            last_uid = uid\n            serial.writeLine(\"UID: \" + uid)\n            serial.writeNumber(card_count)\n            serial.writeLine(\"\")\n            show_oled(uid, card_count)\n            basic.showIcon(IconNames.Yes)\n            basic.pause(300)\n            basic.clearScreen()\n        }\n        \n        card_present = true\n    } else {\n        card_present = false\n    }\n    \n    basic.pause(200)\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":41,"diffs":[[1,"    \"name\": \"rfid-rc522 i2c\",\n"]]}]},{"type":"edited","filename":"main.py","patch":[{"start1":0,"length1":1,"diffs":[[1,""]]},{"start1":45,"length1":29,"diffs":[[1,"# RFID RC522 + KITRONIK OLED 128x64\n"]]},{"start1":114,"length1":124,"diffs":[[1,""]]},{"start1":160,"length1":11,"diffs":[[1,"# Zmienne\n"]]},{"start1":184,"length1":83,"diffs":[[1,"card_count = 0\n"]]},{"start1":267,"length1":14,"diffs":[[1,"# OBSLUGA REJESTROW RC522\n"]]},{"start1":1082,"length1":0,"diffs":[[1,"    # Reset programowy\n"]]},{"start1":1153,"length1":0,"diffs":[[1,"    # Konfiguracja timera\n"]]},{"start1":1284,"length1":0,"diffs":[[1,"    # Konfiguracja transmisji\n"]]},{"start1":1367,"length1":0,"diffs":[[1,"    # Wlaczenie anteny\n"]]},{"start1":1462,"length1":20,"diffs":[[1,"# KOMUNIKACJA Z KARTA\n"]]},{"start1":1640,"length1":64,"diffs":[[1,"    for b in data:\n        write_reg(0x09, b)\n"]]},{"start1":1793,"length1":25,"diffs":[[1,"    for i in range(200):\n"]]},{"start1":2161,"length1":1,"diffs":[[1,""]]},{"start1":2309,"length1":8,"diffs":[[1,"# KONWERSJA NA HEX\n"]]},{"start1":2374,"length1":573,"diffs":[[1,""]]},{"start1":2430,"length1":1,"diffs":[[1,""]]},{"start1":2480,"length1":1,"diffs":[[1,""]]},{"start1":2536,"length1":139,"diffs":[[1,""]]},{"start1":2640,"length1":15,"diffs":[[1,"def read_uid():\n"]]},{"start1":2722,"length1":18,"diffs":[[1,"        return \"\"\n"]]},{"start1":2813,"length1":18,"diffs":[[1,"        return \"\"\n"]]},{"start1":2832,"length1":66,"diffs":[[1,"    bcc = response[0] ^ response[1] ^ response[2] ^ response[3