[1,"\n"]]},{"start1":8036,"length1":0,"diffs":[[1,"\n        display_data = text\n"]]},{"start1":8087,"length1":0,"diffs":[[1,"\n"]]},{"start1":8212,"length1":0,"diffs":[[1,"\n"]]},{"start1":8277,"length1":12,"diffs":[[1,"# PRZYCISK A\n"]]},{"start1":8380,"length1":0,"diffs":[[1,"input.on_button_pressed(Button.A, on_button_a)\n\n\n# ==========================================\n# PRZYCISK B\n# ==========================================\n\n"]]},{"start1":8580,"length1":47,"diffs":[[1,""]]},{"start1":9232,"length1":27,"diffs":[[1,"    global busy, card_present\n"]]},{"start1":10223,"length1":0,"diffs":[[1,"    # Naprzemienne wyswietlanie\n"]]}]}]},{"timestamp":1794066593047,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":419,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tu są testy; nie będzie to kompilowane, gdy ten pakiet będzie używany jako rozszerzenie.\n"}]}],"snapshots":[{"timestamp":1794062745391,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"rfid-rc522 i2c\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794064545739,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"MkJhtzGjzwpdfJ=5$N91\">licznik</variable></variables><block type=\"device_forever\" x=\"294\" y=\"-18\"><statement name=\"HANDLER\"><block type=\"variables_change\"><field name=\"VAR\" id=\"MkJhtzGjzwpdfJ=5$N91\">licznik</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">