field name=\"TEXT\">Witaj!</field></shadow><block type=\"MFRC522_read\" disabled-reasons=\"pxt_automatic_disabled\"></block></value><next><block type=\"device_pause\" disabled-reasons=\"pxt_automatic_disabled\"><value name=\"pause\"><shadow type=\"timePicker\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"ms\">1000</field></shadow></value></block></next></block></next></block></next></block><block type=\"device_show_number\" disabled-reasons=\"pxt_automatic_disabled\" x=\"518\" y=\"549\"><value name=\"number\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">0</field></shadow></value></block></xml>","main.ts":"","README.md":"","pxt.json":"{\n    \"name\": \"rfid-rc522 i2c\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-mfrc522\": \"github:joy-it/pxt-rfid-mfrc522#1.0.1\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1794066593047,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"MkJhtzGjzwpdfJ=5$N91\">licznik</variable></variables></xml>","main.ts":"","README.md":"","main.py":"# ==========================================\n# RFID RC522 + KITRONIK OLED\n# micro:bit V2 - MakeCode Python\n#\n# A = ZAPIS PAWEL\n# B = ZAPIS MICROBIT\n# KARTA = ODCZYT UID I DANYCH\n#\n# MIFARE CLASSIC 1K\n# BLOK 4\n# ==========================================\n\nBLOCK = 4\n\nlast_uid = \"\"\ndisplay_uid = \"\"\ndisplay_data = \"\"\ndisplay_time = 0\ndisplay_page = 0\nbusy = False\ncard_seen = False\n\n\n# ==========================================\n# REJESTRY RC522\n# ==========================================\n\ndef write_reg(reg: number, value: number):\n    pins.digital_write_pin(DigitalPin.P16, 0)\n    pins.spi_write((reg << 1) & 0x7E)\n    pins.spi_write(value & 255)\n    pins.digital_write_pin(DigitalPin.P16, 1)\n\n\ndef read_reg(reg: number) -> number:\n    pins.digital_write_pin(DigitalPin.P16, 0)\n    pins.spi_write(((reg << 1) & 0x7E) | 0x80)\n    value = pins.spi_write(0)\n    pins.digital_write_pin(DigitalPin.P16, 1)\n    return value\n\n\ndef set_bits(reg: number, mask: number):\n    write_reg(reg, read_reg(reg) | mask)\n\n\ndef clear_bits(reg: number, mask: number):\n    write_reg(reg, read_reg(reg) & (255 ^ mask))\n\n\n# ==========================================\n# INICJALIZACJA RC522\n# ==========================================\n\ndef rc522_init():\n    pins.digital_write_pin(DigitalPin.P16, 1)\n    basic.pause(100)\n\n    write_reg(0x01, 0x0F)\n    basic.pause(100)\n\n    write_reg(0x2A, 0x80)\n    write_reg(0x2B, 0xA9)\n    write_reg(0x2C, 0x03)\n    write_reg(0x2D, 0xE8)\n\n    write_reg(0x15, 0x40)\n    write_reg(0x11, 0x3D)\n\n    set_bits(0x14, 0x03)\n\n\n# ==========================================\n# TRANSMISJA RC522\n# ==========================================\n\ndef communicate(data: List[number], last_bits: number) -> List[number]:\n    write_reg(0x01, 0)\n    write_reg(0x04, 0x7F)\n    write_reg(0x0A, 0x80)\n\n    for i in range(len(data)):\n        write_reg(0x09, data[i])\n\n    write_reg(0x0D, last_bits)\n    write_reg(0x01, 0x0C)\n    set_bits(0x0D, 0x80)\n\n    completed = False\n\n    for i in range(300):\n        irq = read_reg(0x04)\n\n        if (irq & 0x30) != 0:\n            completed = True\n            break\n\n        if (irq & 0x01) != 0:\n            break\n\n        control.wait_micros(100)\n\n    clear_bits(0x0D, 0x80)\n\n    if not completed:\n        return []\n\n    if (read_reg(0x06) & 0x13) != 0:\n        return []\n\n    count = read_reg(0x0A)\n    result: List[number] = []\n\n    for i in range(count):\n        result.append(read_reg(0x09))\n\n    return result\n\n\n# ==========================================\n# CRC_A\n# ==========================================\n\ndef crc_a(data: List[number]) -> List[number]:\n    write_reg(0x01, 0)\n    write_reg(0x05, 0x04)\n    write_reg(0x0A, 0x80)\n\n    for i in range(len(data)):\n        write_reg(0x09, data[i])\n\n    write_reg(0x01, 0x03)\n\n    ready = False\n\n    for i in range(300):\n        if (read_reg(0x05) & 0x04) != 0:\n            ready = True\n            break\n\n        control.wait_micros(100)\n\n    if not ready:\n        return []\n\n    # CRCResultRegL, CRCResultRegH\n    return [read_reg(0x22), read_reg(0x21)]\n\n\n# ==========================================\n# HEX\n# ==========================================\n\ndef byte_to_hex(value: number) -> str:\n    digits = \"0123456789ABCDEF\"\n    return digits.char_at((value >> 4) & 15) + digits.char_at(value & 15)\n\n\ndef uid_to_text(data: List[number]) -> str:\n    result = \"\"\n\n    for i in range(len(data)):\n        result = result + byte_to_hex(data[i])\n\n    return result\n\n\n# ==========================================\n# ODCZYT UID\n# ==========================================\n\ndef get_uid() -> List[number]:\n    response = communicate([0x26], 7)\n\n    if len(response) != 2:\n        return []\n\n    response = communicate([0x93, 0x20], 0)\n\n    if len(response) != 5:\n        return []\n\n    check = response[0] ^ response[1] ^ response[2] ^ response[3]\n\n    if check != response[4]:\n        return []\n\n    return [\n        response[0],\n        response[1],\n        response[2],\n        response[3]\n    ]\n\n\n# ==========================================\n# SELECT CARD\n# ==========================================\n\ndef select_card(uid: List[number]) -> bool:\n    data: List[number] = [0x93, 0x70]\n\n    for i in range(4):\n        data.append(uid[i])\n\n    bcc = uid[0] ^ uid[1] ^ uid[2] ^ uid[3]\n    data.append(bcc)\n\n    crc = crc_a(data)\n\n    if len(crc) != 2:\n        return False\n\n    data.append(crc[0])\n    data.append(crc[1])\n\n    response = communicate(data, 0)\n\n    return len(response) == 3\n\n\n# ==========================================\n# AUTHENTICATION\n# ==========================================\n\ndef authenticate(uid: List[number]) -> bool:\n    data: List[number] = [0x60, BLOCK]\n\n    for i in range(6):\n        data.append(255)\n\n    for i in range(4):\n        data.append(uid[i])\n\n    write_reg(0x01, 0)\n    write_reg(0x04, 0x7F)\n    write_reg(0x0A, 0x80)\n\n    for i in range(len(data)):\n        write_reg(0x09, data[i])\n\n    write_reg(0x01, 0x0E)\n\n    success = False\n\n    for i in range(300):\n        irq = read_reg(0x04)\n\n        if (irq & 0x10) != 0:\n            success = True\n            break\n\n        if (irq & 0x01) != 0:\n            break\n\n        control.wait_micros(100)\n\n    if not success:\n        return False\n\n    return (read_reg(0x08) & 0x08) != 0\n\n\ndef stop_crypto():\n    clear_bits(0x08, 0x08)\n\n\n# ==========================================\n# READ BLOCK\n# ==========================================\n\ndef read_block() -> List[number]:\n    data: List[number] = [0x30, BLOCK]\n\n    crc = crc_a(data)\n\n    if len(crc) != 2:\n        return []\n\n    data.append(crc[0])\n    data.append(crc[1])\n\n    response = communicate(data, 0)\n\n    if len(response) != 18:\n        return []\n\n    result: List[number] = []\n\n    for i in range(16):\n        result.append(response[i])\n\n    return result\n\n\n# ==========================================\n# WRITE BLOCK\n# ==========================================\n\ndef write_block(data16: List[number]) -> bool:\n    command: List[number] = [0xA0, BLOCK]\n\n    crc = crc_a(command)\n\n    if len(crc) != 2:\n        return False\n\n    command.append(crc[0])\n    command.append(crc[1])\n\n    response = communicate(command, 0)\n\n    if len(response) != 1:\n        return False\n\n    if (response[0] & 0x0F) != 0x0A:\n        return False\n\n    data: List[number] = []\n\n    for i in range(16):\n        data.append(data16[i])\n\n    crc = crc_a(data)\n\n    if len(crc) != 2:\n        return False\n\n    data.append(crc[0])\n    data.append(crc[1])\n\n    response = communicate(data, 0)\n\n    if len(response) != 1:\n        return False\n\n    return (response[0] & 0x0F) == 0x0A\n\n\n# ==========================================\n# TEXT <-> BYTES\n# ==========================================\n\ndef text_to_bytes(text: str) -> List[number]:\n    result: List[number] = []\n\n    for i in range(len(text)):\n        result.append(text.char_code_at(i))\n\n    while len(result) < 16:\n        result.append(0)\n\n    return result\n\n\ndef bytes_to_text(data: List[number]) -> str:\n    result = \"\"\n\n    for i in range(len(data)):\n        value = data[i]\n\n        if value == 0:\n            break\n\n        if value >= 32 and value <= 126:\n            result = result + String.from_char_code(value)\n\n    return result\n\n\n# ==========================================\n# OLED\n# ==========================================\n\ndef oled(text: str):\n    kitronik_VIEW128x64.clear()\n    kitronik_VIEW128x64.show(text)\n    kitronik_VIEW128x64.refresh()\n\n\n# ==========================================\n# PREPARE CARD\n# ==========================================\n\ndef prepare_card() -> List[number]:\n    stop_crypto()\n\n    uid = get_uid()\n\n    if len(uid) != 4:\n        return []\n\n    if not select_card(uid):\n        return []\n\n    if not authenticate(uid):\n        return []\n\n    return uid\n\n\n# ==========================================\n# ZAPIS\n# ==========================================\n\ndef save_text(text: str):\n    global busy, last_uid\n\n    if busy:\n        return\n\n    busy = True\n\n    oled(\"ZAPIS...\")\n\n    uid = prepare_card()\n\n    if len(uid) != 4:\n        oled(\"BRAK AUTH\")\n        basic.pause(1000)\n        busy = False\n        return\n\n    data = text_to_bytes(text)\n\n    success = write_block(data)\n    stop_crypto()\n\n    if success:\n        oled(\"ZAPIS OK\")\n        basic.show_icon(IconNames.YES)\n        last_uid = \"\"\n    else:\n        oled(\"BLAD ZAPISU\")\n        basic.show_icon(IconNames.NO)\n\n    basic.pause(1200)\n    basic.clear_screen()\n    busy = False\n\n\n# ==========================================\n# PRZYCISKI\n# ==========================================\n\ndef on_button_a():\n    save_text(\"PAWEL\")\n\n\ndef on_button_b():\n    save_text(\"MICROBIT\")\n\n\ninput.on_button_pressed(Button.A, on_button_a)\ninput.on_button_pressed(Button.B, on_button_b)\n\n\n# ==========================================\n# START\n# ==========================================\n\npins.spi_pins(\n    DigitalPin.P14,\n    DigitalPin.P15,\n    DigitalPin.P13\n)\n\npins.spi_format(8, 0)\npins.spi_frequency(1000000)\n\npins.digital_write_pin(DigitalPin.P16, 1)\n\nrc522_init()\n\noled(\"PRZYLOZ KARTE\")\n\nbasic.show_icon(IconNames.DIAMOND)\n\nbasic.pause(1000)\nbasic.clear_screen()\n\n\n# ==========================================\n# PETLA GLOWNA\n# ==========================================\n\ndef on_forever():\n    global last_uid\n    global display_uid, display_data\n    global display_time, display_page\n    global busy, card_seen\n\n    if busy:\n        basic.pause(100)\n        return\n\n    uid = get_uid()\n\n    if len(uid) == 4:\n        uid_text = uid_to_text(uid)\n\n        if uid_text != last_uid:\n            busy = True\n\n            display_uid = uid_text\n            display_data = \"BRAK ODCZYTU\"\n\n            if select_card(uid):\n                if authenticate(uid):\n                    data = read_block()\n                    stop_crypto()\n\n                    if len(data) == 16:\n                        display_data = bytes_to_text(data)\n\n                        if display_data == \"\":\n                            display_data = \"PUSTE\"\n                else:\n                    display_data = \"BRAK AUTH\"\n\n            last_uid = uid_text\n           